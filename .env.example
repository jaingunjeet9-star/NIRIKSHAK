# =============================================================================
# NIRIKSHAK — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env or .env.production to version control.
#
# When deploying to Vercel: set these in the Vercel Dashboard under
#   Project → Settings → Environment Variables
# =============================================================================

# ---------------------------------------------------------------------------
# AI Vision API Keys (at least one required)
# ---------------------------------------------------------------------------

# GROQ_API_KEY: Primary high-speed Vision AI (recommended — free tier available)
# Obtain at: https://console.groq.com/keys
# Supports Groq Llama Vision and xAI Grok Vision (prefix your xAI key with xai-)
GROQ_API_KEY=

# GEMINI_API_KEY: Fallback Google Gemini Vision AI
# Obtain at: https://aistudio.google.com/app/apikey
# Supports multiple comma-separated keys for rotation: key1,key2,key3
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Application URL
# ---------------------------------------------------------------------------

# The public URL where this application is hosted.
# Development: http://localhost:3000
# Production:  https://your-project.vercel.app
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# SMTP Email (optional — only required for password-reset email delivery)
# ---------------------------------------------------------------------------
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=your-smtp-user
# EMAIL_PASSWORD=your-smtp-password
# EMAIL_FROM=NIRIKSHAK <no-reply@example.com>
